<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.hamlog.hambot.awake</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/caffeinate</string>
		<string>-d</string>
		<string>-i</string>
		<string>-s</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>STATE_DIR/awake.err</string>
	<key>StandardOutPath</key>
	<string>STATE_DIR/awake.log</string>
	<key>ThrottleInterval</key>
	<integer>15</integer>
</dict>
</plist>
