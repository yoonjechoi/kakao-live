<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>KAKAO_HOME</key>
		<string>STATE_DIR</string>
		<key>KAKAO_LIVE_SCRIPTS</key>
		<string>REPO_ROOT/skills/kakao-live/scripts</string>
		<key>PATH</key>
		<string>BIN_DIR:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.hamlog.hambot.runtime</string>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>REPO_ROOT/examples/ham-bot/ham_bot_runtime.py</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>STATE_DIR/runtime.err</string>
	<key>StandardOutPath</key>
	<string>STATE_DIR/runtime.log</string>
	<key>ThrottleInterval</key>
	<integer>15</integer>
</dict>
</plist>
